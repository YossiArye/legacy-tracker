{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "{ echo \"=== $(date '+%Y-%m-%d %H:%M:%S') ===\"; npm test; } >> .claude/test-log.txt 2>&1"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(npm test)",
      "Bash(npm test *)",
      "Bash(npm run lint)",
      "Bash(npm run lint *)",
      "Bash(git status)",
      "Bash(git status *)",
      "mcp__github__get_commit"
    ],
    "deny": [
      "Bash(rm -rf *)",
      "Bash(git push --force)",
      "Bash(git push --force *)",
      "Bash(git push -f)",
      "Bash(git push -f *)",
      "mcp__github__create_repository"
    ]
  }
}
